# Referencia de variables de entorno del proyecto AulaQuipu.
# El frontend Next.js las consume en .env.local (route handlers y cliente).

# Conexión al aula (LiveKit self-hosted en docker, mismo API key/secret que el servidor).
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Supabase: publishable key en el cliente; secret solo para RPCs/escrituras server-side.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Worker del tutor IA (backend/agents/aulaquipu-tutor).
OPENAI_API_KEY=
