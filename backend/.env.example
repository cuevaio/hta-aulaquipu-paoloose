# Referencia de variables de entorno del proyecto AulaQuipu.
# La web (apps/web-app) las lee de apps/web-app/.env.local (ver apps/web-app/.env.example).
# El agente (backend/agents/aulaquipu-tutor) las lee de su .env.local o de backend/.env.

# Conexión al aula (LiveKit: mismo API key/secret en servidor, web y agente).
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Supabase: publishable key en el cliente; secret solo en servidor (API de Next y agente).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Worker del tutor IA y normalización de temas.
OPENAI_API_KEY=

# Memoria de clases (AtomicMemory Cloud).
ATOMICMEMORY_API_URL=https://api.atomicstrata.ai
ATOMICMEMORY_API_KEY=
