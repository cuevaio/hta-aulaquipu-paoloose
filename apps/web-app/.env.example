# Copia este archivo a .env.local y completa los valores. .env.local está en .gitignore.

# Fuente de datos: "http" (por defecto: API de Next + Supabase) o "mock" (datos ficticios en el navegador)
NEXT_PUBLIC_API_MODE=http

# Supabase (claves públicas: se pueden exponer)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase (solo servidor: NUNCA con prefijo NEXT_PUBLIC_). La API de Next escribe con esta clave.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Firma de la cookie de sesión. Opcional: si falta se deriva de SUPABASE_SECRET_KEY.
AUTH_SECRET=

# LiveKit (mismo API key/secret que el servidor y el agente). Sin estos valores el aula usa el tutor simulado.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# URL que usa el NAVEGADOR si es distinta (p. ej. wss://livekit.tu-tunel.com detrás de Cloudflare Tunnel)
LIVEKIT_PUBLIC_URL=

# Normalización de temas con LLM (opcional; sin clave se usan palabras clave)
OPENAI_API_KEY=
OPENAI_TOPIC_MODEL=gpt-4.1-mini

# Mostrar las cuentas de prueba (DNI 700000NN / aula2026) en el login. Pon "false" para ocultarlas.
AULAQUIPU_SHOW_TEST_ACCOUNTS=true

# Desmos API v1.12. Sin valor se usa la clave pública de demostración (muestra aviso "Trial Key")
NEXT_PUBLIC_DESMOS_API_KEY=
