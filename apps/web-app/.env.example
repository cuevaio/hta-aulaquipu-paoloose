# Fuente de datos del cliente: "mock" (datos ficticios en el navegador) o "http" (API Node del §9)
NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Desmos API v1.12. Sin valor se usa la clave pública de demostración (muestra aviso "Trial Key")
NEXT_PUBLIC_DESMOS_API_KEY=

# Supabase (claves públicas)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
